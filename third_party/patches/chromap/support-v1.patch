@@ -0,0 +1,37 @@
+#ifndef CHROMAP_DUPLICATE_SUPPORT_H_
+#define CHROMAP_DUPLICATE_SUPPORT_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include "bed_mapping.h"
+#include "utils.h"
+
+namespace chromap {
+inline void IncrementDuplicateSupport(uint64_t &count) {
+  if (count == std::numeric_limits<uint64_t>::max()) {
+    ExitWithMessage("AGENT_DUPLICATE_SUPPORT_OVERFLOW");
+  }
+  ++count;
+}
+
+// Preserve upstream saturation for output types outside the qualified route.
+template <typename MappingRecord>
+inline void SetDuplicateSupport(MappingRecord &mapping, uint64_t count) {
+  mapping.num_dups_ = std::min(uint64_t(255), count);
+}
+inline void SetDuplicateSupport(PairedEndMappingWithBarcode &mapping,
+                                uint64_t count) {
+  mapping.num_dups_ = count;
+}
+
+// Upstream optional summary fields are signed int, not fragment support.
+// Refuse narrowing rather than publishing a wrapped summary.
+inline int DuplicateSupportSummaryCount(uint64_t count) {
+  if (count > uint64_t(std::numeric_limits<int>::max())) {
+    ExitWithMessage("AGENT_DUPLICATE_SUMMARY_OVERFLOW");
+  }
+  return static_cast<int>(count);
+}
+}  // namespace chromap
+#endif
